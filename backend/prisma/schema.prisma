// Esquema de la base de datos de Mussic Sonnar.
// Cambios: editar este archivo y ejecutar `npm run db:migrate` (crea la migración y regenera el cliente).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// Cuenta de usuario. La autenticación completa llega en la Fase 2.
model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("users")
}
